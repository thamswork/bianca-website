<div id="dish-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(26,61,43,0.88);align-items:center;justify-content:center;padding:40px;">
  <div id="dish-modal-inner" style="background:#FFF1DA;max-width:760px;width:100%;display:grid;grid-template-columns:1fr 1fr;max-height:90vh;overflow:hidden;transform:scale(0.95);opacity:0;transition:all 0.35s ease;">
    <img id="modal-img" src="" style="width:100%;height:100%;object-fit:cover;min-height:400px;" />
    <div style="padding:48px 40px;display:flex;flex-direction:column;justify-content:center;overflow-y:auto;">
      <div id="modal-cat" style="font-family:'GillSans',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:#FAB31E;margin-bottom:12px;"></div>
      <h3 id="modal-name" style="font-family:'Satisfy',cursive;font-size:32px;color:#235E44;margin-bottom:16px;line-height:1.2;"></h3>
      <div style="width:40px;height:2px;background:#FAB31E;margin-bottom:20px;"></div>
      <p id="modal-desc" style="font-family:'GillSans',sans-serif;font-size:14px;font-weight:300;color:#444;line-height:1.85;margin-bottom:20px;"></p>
      <div id="modal-ingredients" style="font-family:'GillSans',sans-serif;font-size:12px;color:#235E44;font-weight:500;letter-spacing:0.06em;margin-bottom:28px;line-height:1.8;"></div>
      <div style="display:flex;gap:12px;">
        <button style="flex:1;background:#235E44;color:#FFF1DA;border:none;cursor:pointer;padding:12px;font-family:'GillSans',sans-serif;font-size:13px;font-weight:700;letter-spacing:0.08em;transition:all 0.3s;" onmouseover="this.style.background='#FAB31E';this.style.color='#235E44'" onmouseout="this.style.background='#235E44';this.style.color='#FFF1DA'">Reserve a table</button>
        <button onclick="closeDish()" style="padding:12px 20px;background:transparent;color:#235E44;border:1px solid rgba(35,94,68,0.3);cursor:pointer;font-family:'GillSans',sans-serif;font-size:13px;transition:all 0.3s;" onmouseover="this.style.background='#235E44';this.style.color='#FFF1DA'" onmouseout="this.style.background='transparent';this.style.color='#235E44'">Close</button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  var dishes = [
    {img:'https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?w=900&q=80',cat:'Pasta · Classic',name:'Spaghetti al Pomodoro',desc:'Our most beloved dish — San Marzano tomatoes slow-cooked with fresh basil and extra virgin olive oil, tossed with perfectly al dente spaghetti. Simple, honest, unforgettable.',ingredients:'San Marzano tomatoes · Fresh basil · Extra virgin olive oil · Spaghetti · Sea salt'},
    {img:'https://images.unsplash.com/photo-1574071318508-1cdbab80d002?w=900&q=80',cat:'Pizza · Signature',name:'Margherita DOC',desc:'Certified Neapolitan-style pizza with a hand-stretched base, San Marzano tomato sauce, fresh fior di latte mozzarella, and basil from our Chiang Mai supplier.',ingredients:'00 flour · San Marzano tomatoes · Fior di latte · Fresh basil · Sea salt'},
    {img:'https://images.unsplash.com/photo-1476124369491-e7addf5db371?w=900&q=80',cat:'Risotto · Seasonal',name:'Risotto al Funghi',desc:'Carnaroli rice slow-stirred to a perfect creamy consistency, finished with wild porcini mushrooms, aged Parmigiano Reggiano, and a drizzle of truffle oil.',ingredients:'Carnaroli rice · Porcini mushrooms · Parmigiano Reggiano · Truffle oil · Shallots · White wine'},
    {img:'https://images.unsplash.com/photo-1555072956-7758afb20e8f?w=900&q=80',cat:'Antipasti · Fresh',name:'Burrata della Casa',desc:'Our house-made burrata — pulled fresh every morning — served with heirloom tomatoes, Sicilian green olives, and a generous pour of our best olive oil.',ingredients:'Fresh burrata · Heirloom tomatoes · Sicilian olives · Extra virgin olive oil · Fleur de sel · Fresh basil'},
    {img:'https://images.unsplash.com/photo-1571877227200-a0d98ea607e9?w=900&q=80',cat:'Dessert · Daily',name:'Tiramisù della Casa',desc:'Our tiramisù has become something of a legend. Savoiardi soaked in strong espresso, layered with mascarpone cream and finished with a generous dusting of Valrhona cocoa.',ingredients:'Mascarpone · Savoiardi · Espresso · Valrhona cocoa · Eggs · Marsala wine'},
    {img:'https://images.unsplash.com/photo-1548943487-a2e4e43b4853?w=900&q=80',cat:'Pasta · Handmade',name:'Tagliatelle al Ragù',desc:'Hand-rolled egg tagliatelle paired with a slow-cooked Bolognese ragù — beef and pork braised for six hours with soffritto, wine, and patience.',ingredients:'Egg tagliatelle · Beef · Pork · Soffritto · Red wine · Parmigiano Reggiano'},
  ];

  function openDish(i){
    var d = dishes[i];
    document.getElementById('modal-img').src = d.img;
    document.getElementById('modal-cat').textContent = d.cat;
    document.getElementById('modal-name').textContent = d.name;
    document.getElementById('modal-desc').textContent = d.desc;
    document.getElementById('modal-ingredients').innerHTML = '<strong style="display:block;margin-bottom:6px;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#FAB31E;">Ingredients</strong>' + d.ingredients;
    var modal = document.getElementById('dish-modal');
    var inner = document.getElementById('dish-modal-inner');
    modal.style.display = 'flex';
    modal.style.alignItems = 'center';
    modal.style.justifyContent = 'center';
    setTimeout(function(){ inner.style.transform='scale(1)'; inner.style.opacity='1'; }, 20);
    document.body.style.overflow = 'hidden';
  }

  function closeDish(){
    var inner = document.getElementById('dish-modal-inner');
    var modal = document.getElementById('dish-modal');
    inner.style.transform = 'scale(0.95)';
    inner.style.opacity = '0';
    setTimeout(function(){ modal.style.display='none'; document.body.style.overflow=''; }, 350);
  }

  document.getElementById('dish-modal').addEventListener('click', function(e){
    if(e.target === this) closeDish();
  });

  document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeDish(); });
