<script is:inline>
  const slideIndexes = [0,0,0,0,0];
  let currentLoc = 0;
  let userInteracted = false;
  let autoRotateTimer = null;

  function startAutoRotate() {
    if(autoRotateTimer) clearInterval(autoRotateTimer);
    autoRotateTimer = setInterval(() => {
      if(!userInteracted) {
        currentLoc = (currentLoc + 1) % 5;
        showLoc(currentLoc);
      }
    }, 3500);
  }

  startAutoRotate();

  function goToSlide(loc, idx){
    slideIndexes[loc] = idx;
    const track = document.querySelector(`#carousel-${loc} .carousel-track`);
    if(track) track.style.transform = `translateX(-${idx*100}%)`;
    const dots = document.querySelectorAll(`#dots-${loc} .dot`);
    dots.forEach((d,i) => { d.style.background = i===idx ? '#FAB31E' : 'rgba(255,241,218,0.5)'; });
  }

  function nextSlide(loc){
    const next = (slideIndexes[loc]+1)%5;
    goToSlide(loc,next);
  }

  function prevSlide(loc){
    const prev = (slideIndexes[loc]-1+5)%5;
    goToSlide(loc,prev);
  }

  function showLoc(i, manual=false){
    if(manual){ userInteracted = true; if(autoRotateTimer) clearInterval(autoRotateTimer); }
    currentLoc = i;
    const panels = document.querySelectorAll('.loc-panel');
    const tabs = document.querySelectorAll('.loc-tab');
    const current = Array.from(panels).find(p => p.style.display === 'grid');
    
    if(current) {
      current.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      current.style.opacity = '0';
      current.style.transform = 'translateY(8px)';
      setTimeout(() => {
        current.style.display = 'none';
        const next = panels[i];
        next.style.display = 'grid';
        next.style.opacity = '0';
        next.style.transform = 'translateY(8px)';
        setTimeout(() => {
          next.style.transition = 'opacity 0.7s ease, transform 0.7s ease';
          next.style.opacity = '1';
          next.style.transform = 'translateY(0)';
        }, 20);
      }, 550);
    } else {
      panels[i].style.display = 'grid';
      panels[i].style.opacity = '1';
    }

    tabs.forEach((t,idx) => {
      t.style.transition = 'all 0.4s ease';
      t.style.color = idx===i ? '#235E44' : 'rgba(35,94,68,0.4)';
      t.style.borderBottom = idx===i ? '3px solid #FAB31E' : '3px solid transparent';
    });
  }

  const blocks = document.querySelectorAll('.reveal-block');
  const obs = new IntersectionObserver(entries=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.style.opacity='1'; e.target.style.transform='translateY(0)'; } });
  },{threshold:0.15});
  blocks.forEach(b=>obs.observe(b));
</script>
