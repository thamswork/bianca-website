<footer style="background:#1a3d2b;padding:clamp(40px,4vw,60px) clamp(24px,4vw,80px) 28px;">
  <div style="width:100%;max-width:1400px;margin:0 auto;">
    <div class="footer-reveal" style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:48px;opacity:0;transform:translateY(24px);transition:all 0.7s ease;">
      <div>
        <div style="font-family:'Antonio',sans-serif;font-size:22px;font-weight:700;color:#FFF1DA;letter-spacing:0.08em;margin-bottom:12px;cursor:pointer;transition:color 0.2s;" onmouseover="this.style.color='#FAB31E'" onmouseout="this.style.color='#FFF1DA'">BIANCA</div>
        <div style="font-family:'Satisfy',cursive;font-size:16px;color:#FAB31E;margin-bottom:16px;">Cucina Italiana</div>
        <p style="font-family:'GillSans',sans-serif;font-size:13px;color:rgba(255,241,218,0.45);line-height:1.8;max-width:220px;">Modern Italian Classics. Five Bangkok locations. Honest ingredients, Italian soul.</p>
      </div>
      {[
        ['Visit',['Emsphere','One Bangkok','Siam Paragon','ICONSIAM','Terminal 21']],
        ['Explore',['Menu','Stories','Private Dining','Catering','Partnerships']],
        ['Connect',['Instagram','Facebook','LINE OA','Contact Us']],
      ].map(([title,links]) => (
        <div>
          <h4 style="font-family:'GillSans',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,241,218,0.4);margin-bottom:16px;">{title}</h4>
          {links.map(link => (
            <a href="#" style="display:block;font-family:'GillSans',sans-serif;font-size:13px;color:rgba(255,241,218,0.65);text-decoration:none;margin-bottom:10px;transition:all 0.2s;" onmouseover="this.style.color='#FAB31E';this.style.paddingLeft='6px'" onmouseout="this.style.color='rgba(255,241,218,0.65)';this.style.paddingLeft='0'">{link}</a>
          ))}
        </div>
      ))}
    </div>
    <div class="footer-reveal" style="border-top:1px solid rgba(255,241,218,0.1);padding-top:20px;display:flex;justify-content:space-between;align-items:center;opacity:0;transition:all 0.7s ease 0.2s;">
      <span style="font-family:'GillSans',sans-serif;font-size:12px;color:rgba(255,241,218,0.3);">© 2025 BIANCA Restaurant Group</span>
      <span style="font-family:'GillSans',sans-serif;font-size:12px;color:rgba(255,241,218,0.3);">Privacy · Terms</span>
    </div>
  </div>
</footer>

<script is:inline>
  const footerItems = document.querySelectorAll('.footer-reveal');
  const footerObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if(e.isIntersecting) { e.target.style.opacity='1'; e.target.style.transform='translateY(0)'; }
    });
  }, {threshold: 0.1});
  footerItems.forEach(el => footerObs.observe(el));
</script>
