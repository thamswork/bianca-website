<section style="position:relative;height:100vh;overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=1600&q=80" alt="BIANCA" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;animation:heroZoom 8s ease forwards;" />
  <div style="position:absolute;inset:0;background:linear-gradient(to right,rgba(0,0,0,0.75) 0%,rgba(0,0,0,0.35) 55%,rgba(0,0,0,0.05) 100%);"></div>
  <div style="position:relative;z-index:2;height:100%;display:flex;align-items:center;padding:0 clamp(32px,5vw,120px);">
    <div style="max-width:640px;">
      <div style="font-family:'GillSans',sans-serif;font-size:12px;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;color:#FAB31E;margin-bottom:24px;opacity:0;animation:fadeUp 0.8s ease 0.3s forwards;">Modern Italian · Bangkok</div>
      <h1 style="font-family:'Satisfy',cursive;font-size:76px;color:#FFF1DA;line-height:1.15;margin-bottom:20px;opacity:0;animation:fadeUp 0.8s ease 0.5s forwards;">Modern Twist of Italian Classics</h1>
      <div style="width:56px;height:2px;background:#FAB31E;margin-bottom:24px;opacity:0;animation:fadeUp 0.8s ease 0.7s forwards;"></div>
      <p style="font-family:'GillSans',sans-serif;font-size:17px;font-weight:300;color:rgba(255,241,218,0.82);line-height:1.8;margin-bottom:40px;max-width:440px;opacity:0;animation:fadeUp 0.8s ease 0.9s forwards;">Five locations across Bangkok. Everything we do is 100% fresh and homemade — honest ingredients, Italian soul.</p>
      <div style="display:flex;gap:16px;opacity:0;animation:fadeUp 0.8s ease 1.1s forwards;">
        <button style="background:#FAB31E;color:#235E44;border:none;cursor:pointer;padding:16px 36px;font-family:'GillSans',sans-serif;font-size:14px;font-weight:700;letter-spacing:0.06em;transition:all 0.3s;" onmouseover="this.style.background='#235E44';this.style.color='#FAB31E';this.style.transform='translateY(-3px)'" onmouseout="this.style.background='#FAB31E';this.style.color='#235E44';this.style.transform='translateY(0)'">Explore the menu</button>
        <button style="background:transparent;color:#FFF1DA;border:1px solid rgba(255,241,218,0.4);cursor:pointer;padding:16px 36px;font-family:'GillSans',sans-serif;font-size:14px;letter-spacing:0.06em;transition:all 0.3s;" onmouseover="this.style.background='rgba(255,241,218,0.1)';this.style.borderColor='rgba(255,241,218,0.8)';this.style.transform='translateY(-3px)'" onmouseout="this.style.background='transparent';this.style.borderColor='rgba(255,241,218,0.4)';this.style.transform='translateY(0)'">Our locations</button>
