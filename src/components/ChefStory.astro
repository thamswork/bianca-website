<section style="display:grid;grid-template-columns:1fr 1fr;background:#FFF1DA;width:100%;">
  <div style="position:relative;min-height:640px;overflow:hidden;">
    <img src="https://images.unsplash.com/photo-1577219491135-ce391730fb2c?w=900&q=80" alt="BIANCA Chef" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 8s ease;transform:scale(1.05);" class="chef-img" />
    <div style="position:absolute;inset:0;background:linear-gradient(to right,transparent 55%,#FFF1DA 100%);"></div>
    <div style="position:absolute;bottom:40px;left:40px;opacity:0;transform:translateY(20px);transition:all 0.7s ease 0.4s;" class="chef-reveal">
      <div style="background:#FAB31E;display:inline-block;padding:14px 22px;cursor:default;transition:transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
        <div style="font-family:'GillSans',sans-serif;font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#235E44;">Est. Bangkok</div>
        <div style="font-family:'GillSans',sans-serif;font-size:40px;font-weight:700;color:#235E44;line-height:1;">2023</div>
      </div>
    </div>
  </div>

  <div style="padding:clamp(40px,5vw,80px) clamp(32px,5vw,64px);display:flex;flex-direction:column;justify-content:center;">
    <div class="chef-reveal" style="font-family:'GillSans',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#FAB31E;margin-bottom:16px;transition:all 0.6s ease 0.1s;">Our story</div>

    <h2 class="chef-reveal" style="font-family:'Satisfy',cursive;font-size:44px;color:#235E44;line-height:1.2;margin-bottom:24px;text-shadow:4px 4px 8px rgba(0,0,0,0.18),1px 1px 0px rgba(0,0,0,0.08);transition:all 0.6s ease 0.2s;";text-shadow:4px 4px 8px rgba(0,0,0,0.18),1px 1px 0px rgba(0,0,0,0.08);">Italian Classics, Honestly Made</h2>

    <div class="chef-reveal" style="width:48px;height:2px;background:#FAB31E;margin-bottom:28px;transition:all 0.6s ease 0.3s;"></div>

    <p class="chef-reveal" style="font-family:'GillSans',sans-serif;font-size:16px;font-weight:300;color:#444;line-height:1.9;margin-bottom:36px;transition:all 0.6s ease 0.35s;">BIANCA was born in 2023 from a simple, unshakeable belief — that great Italian food doesn't need theatre. It needs honesty. The right flour, tomatoes grown in real sun, pasta shaped by hands that know what they're doing.</p>

    <p class="chef-reveal" style="font-family:'GillSans',sans-serif;font-size:16px;font-weight:300;color:#444;line-height:1.9;margin-bottom:20px;transition:all 0.6s ease 0.4s;">We brought those principles to Bangkok and found a city that was ready for them. No fusion, no shortcuts — just the food you'd eat sitting at a table in Naples or Bologna, reimagined with the freshest ingredients Thailand has to offer.</p>


    <div class="chef-reveal" style="padding:24px 0;border-top:1px solid rgba(35,94,68,0.12);border-bottom:1px solid rgba(35,94,68,0.12);margin-bottom:32px;transition:all 0.6s ease 0.5s;">
      <div style="font-family:'Satisfy',cursive;font-size:20px;color:#235E44;line-height:1.6;">"We didn't come to Bangkok to impress anyone. We came to cook."</div>
      <div style="font-family:'GillSans',sans-serif;font-size:12px;color:#FAB31E;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-top:10px;">— BIANCA Founders</div>
    </div>

    <a class="chef-reveal" href="#" style="font-family:'GillSans',sans-serif;font-size:13px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#235E44;text-decoration:none;display:inline-flex;align-items:center;gap:8px;transition:color 0.2s,gap 0.2s;" onmouseover="this.style.color='#FAB31E';this.style.gap='16px'" onmouseout="this.style.color='#235E44';this.style.gap='8px'">Read the full story <span style="font-size:18px;">→</span></a>
  </div>
</section>

<script is:inline>
  const chefItems = document.querySelectorAll('.chef-reveal');
  const chefImg = document.querySelector('.chef-img');
  const chefObs = new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        chefItems.forEach(el=>{ el.style.opacity='1'; el.style.transform='translateY(0)'; });
        if(chefImg) chefImg.style.transform='scale(1)';
      }
    });
  },{threshold:0.15});
  const chefSection = document.querySelector('.chef-img');
  if(chefSection) chefObs.observe(chefSection.closest('section'));
</script>
